{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MACS+ Automation",
  "version": "0.1.0-rc.11",
  "identifier": "com.firedynamicsgroup.i-macs",
  "build": {
    "beforeDevCommand": "npm run dev:vite",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build:vite",
    "frontendDist": "../dist-frontend"
  },
  "app": {
    "windows": [
      {
        "title": "MACS+ Automation",
        "width": 1100,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "binaries/i-macs-sidecar-x86_64-pc-windows-msvc/**/*"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Desktop runner for MACS+ FRACOF fire-engineering calculations",
    "longDescription": "Desktop UI for MACS+ FRACOF — single-run calculation today, parameter sweeps + LHS + reporting in follow-up releases. Bundles a 32-bit Python sidecar that drives the SCTI11.FRACOF COM engine."
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/Fire-Dynamics-Group/i-macs/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDUwMzlEMjU4Nzk0NDVDN0EKUldSNlhFUjVXTkk1VUw4dm5FaENIMlZ6dTB2VjRqK0QxOTlROVJEQTM2L2NJZzFGYncvRVgxRWwK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
